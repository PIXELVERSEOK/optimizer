<UserControl x:Class="EvoOptimizer.App.Views.EvoHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,2,4,14">
            <StackPanel>
                <TextBlock Text="Historial y recuperación"
                           FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="Registros locales de operaciones y mediciones. La revisión es de solo lectura."
                           Foreground="{StaticResource DimBrush}" FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="CAMBIOS ACTIVOS"
                        Margin="0,0,8,0"
                        Click="OpenActiveChanges_Click"
                        ToolTip="Abrir el panel existente de cambios activos y reversión"/>
                <Button Content="ACTUALIZAR"
                        IsEnabled="{Binding CanRefresh}"
                        Click="Refresh_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="4">
                <StackPanel>
                    <TextBlock Text="RESUMEN" Foreground="{StaticResource DimBrush}"
                               FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SummaryText}" FontSize="16"
                               FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource DimBrush}"
                               TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="4">
                <StackPanel>
                    <TextBlock Text="CATEGORÍAS REGISTRADAS"
                               Foreground="{StaticResource DimBrush}"
                               FontSize="10" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,7,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141B24" CornerRadius="5"
                                        Padding="8,5" Margin="0,0,6,5">
                                    <TextBlock FontSize="10">
                                        <Run Text="{Binding Category}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Count}"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding RecentRecords}"
                      SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      AlternationCount="2"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha capturada"
                                        Binding="{Binding CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                        Width="155"/>
                    <DataGridTextColumn Header="Categoría"
                                        Binding="{Binding Category}"
                                        Width="145"/>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DETALLE DEL REGISTRO"
                               Foreground="{StaticResource DimBrush}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedPayload, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="#090D13"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource LineBrush}"
                             FontFamily="Consolas"
                             FontSize="10"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
