<UserControl x:Class="EvoOptimizer.App.Views.EvoDashboardShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:EvoOptimizer.App.Controls"
             xmlns:navigation="clr-namespace:EvoOptimizer.App.Navigation"
             xmlns:views="clr-namespace:EvoOptimizer.App.Views"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0D1118"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource DimText}">
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F3F7FC"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8C2D0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ModuleNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AreaNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="5,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="AreaAnalyzeButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#27313D"/>
            <Setter Property="Foreground" Value="#168BFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0A0E14"/>
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="RowBackground" Value="#0D1118"/>
            <Setter Property="AlternatingRowBackground" Value="#141B24"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#202833"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111821"/>
            <Setter Property="Foreground" Value="#9AA8B8"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DiagnosticItem" TargetType="Border">
            <Setter Property="Background" Value="#141B24"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#080B10"
                BorderBrush="#222B35" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <TextBlock Text="EVO" FontSize="29" FontWeight="Black"
                               FontStyle="Italic" Foreground="#148CFF"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="42" Background="#303945" Margin="18,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EVO FPS OPTIMIZER" FontSize="16"
                                   FontWeight="SemiBold" Foreground="#F3F7FC"/>
                        <TextBlock Text="Rendimiento. Estabilidad. Control total."
                                   FontSize="10" Foreground="#96A3B2"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="#303945" BorderThickness="1,0,0,0"
                        Padding="18,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22" Foreground="#42D392"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CAMBIOS CON CONFIRMACIÓN"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#42D392"/>
                            <TextBlock Text="No se declaran mejoras sin mediciones"
                                       FontSize="9" Foreground="#96A3B2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="#303945" BorderThickness="1,0,0,0"
                        Padding="18,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22" Foreground="#168BFF"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MODO ACTUAL" FontSize="9"
                                       Foreground="#96A3B2"/>
                            <TextBlock Text="{Binding SelectedGoal.Label}"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ClockText}"
                                       FontSize="9" Foreground="#96A3B2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets" ToolTip="Minimizar"
                            Click="MinimizeWindow_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets" ToolTip="Maximizar o restaurar"
                            Click="ToggleMaximizeWindow_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" ToolTip="Cerrar"
                            Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#090D13"
                    BorderBrush="#202833" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,20,12,12">
                            <TextBlock Text="ÁREAS DEL SISTEMA" Style="{StaticResource SectionTitle}"
                                       Margin="10,0,0,10"/>
                            <ItemsControl ItemsSource="{x:Static navigation:EvoNavigationCatalog.Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="{Binding InitiallyExpanded, Mode=OneWay}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Margin="0,0,0,3">
                                            <Expander.Header>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource AreaNavButton}"
                                                            Click="NavigateCategory_Click"
                                                            ToolTip="{Binding AnalysisDetails}">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock Text="{Binding Number}"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"
                                                                       Width="23"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Icon}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontSize="13"
                                                                       Margin="0,0,7,0"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource AreaAnalyzeButton}"
                                                            Content="ANALIZAR"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            ToolTip="{Binding AnalysisDetails}"
                                                            Click="AnalyzeCategory_Click"/>
                                                </Grid>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Modules}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ModuleNavButton}"
                                                                ToolTip="{Binding Description}"
                                                                Click="NavigateModule_Click">
                                                            <DockPanel LastChildFill="True">
                                                                <Border DockPanel.Dock="Right"
                                                                        Background="#18212C"
                                                                        CornerRadius="3"
                                                                        Padding="4,2"
                                                                        Margin="4,0,0,0">
                                                                    <TextBlock Text="{Binding StatusLabel}"
                                                                               Foreground="{Binding StatusColor}"
                                                                               FontSize="7"
                                                                               FontWeight="Bold"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="#222B35" Margin="8,14"/>
                            <TextBlock Text="OBJETIVO DE USO" Style="{StaticResource SectionTitle}"
                                       Margin="10,0,0,8"/>
                            <ListBox ItemsSource="{Binding Goals}"
                                     SelectedItem="{Binding SelectedGoal, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource GoalItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding SelectedGoalDescription}"
                                       Style="{StaticResource Muted}" Margin="8,8,8,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="#101720" BorderBrush="#26303B"
                            BorderThickness="1" CornerRadius="11" Padding="12"
                            Margin="12,8,12,12">
                        <StackPanel>
                            <TextBlock Text="EVO · EVIDENCIA REAL" FontWeight="Bold"
                                       FontSize="11" Foreground="#168BFF"/>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" x:Name="MainContentArea"
                    Background="{StaticResource BgBrush}">
            <TabControl x:Name="MainPages"
                        Background="{StaticResource BgBrush}" BorderThickness="0">
                <TabItem Header="Dashboard">
                    <ScrollViewer x:Name="DashboardScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="16,12,18,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="6,4,6,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BIENVENIDO A EVO FPS OPTIMIZER"
                                               FontSize="21" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="#A5B1C0" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="16,0,4,0">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="22" Foreground="#168BFF"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="ESTADO DEL SISTEMA" FontSize="9"
                                                   Foreground="#96A3B2"/>
                                        <TextBlock x:Name="SystemHealthStatus"
                                                   Text="Sin evaluación reciente"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#F5B84B"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="5" Margin="-5,0,-5,4">
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="CPU" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{Binding Hardware.CpuName, TargetNullValue='No disponible'}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CpuText}" Style="{StaticResource MetricValue}"
                                                       Foreground="#168BFF" Margin="0,9,0,0"/>
                                            <TextBlock Text="{Binding CpuNominalText}" Style="{StaticResource Muted}"/>
                                            <ProgressBar Value="{Binding CpuUsagePercentValue, Mode=OneWay}"
                                                         Maximum="100" Margin="0,8,0,0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CpuUsagePercentValue}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                        <ctl:Sparkline Grid.Column="1" Height="45" Width="68"
                                                       VerticalAlignment="Bottom"
                                                       Values="{Binding CpuHistory}"
                                                       Stroke="{StaticResource AccentBrush}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="GPU" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{Binding GpuLines[0], TargetNullValue='No disponible'}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Uso no disponible"
                                                   Style="{StaticResource MetricValue}"
                                                   FontSize="17" Foreground="#A5B1C0" Margin="0,9,0,0"/>
                                        <TextBlock Text="Sin fuente de uso / VRAM"
                                                   Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="RAM" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{Binding RamText}" FontSize="11"/>
                                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource MetricValue}"
                                                   Foreground="#168BFF" Margin="0,9,0,0"/>
                                        <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Value="{Binding MemoryUsagePercentValue, Mode=OneWay}" Maximum="100">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MemoryUsagePercentValue}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="ALMACENAMIENTO" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Capacidad / uso" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="No disponible"
                                                   Style="{StaticResource MetricValue}"
                                                   FontSize="17" Foreground="#A5B1C0" Margin="0,9,0,0"/>
                                        <TextBlock Text="Auditoría de discos pendiente"
                                                   Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="WINDOWS" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{Binding Hardware.OsDescription, TargetNullValue='No disponible'}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Actualizaciones"
                                                   Style="{StaticResource MetricValue}"
                                                   FontSize="16" Foreground="#A5B1C0" Margin="0,9,0,0"/>
                                        <TextBlock Text="Estado no medido"
                                                   Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="2" Margin="-5,2,-5,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.25*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="RENDIMIENTO EN TIEMPO REAL"
                                                       Style="{StaticResource CardTitle}"
                                                       FontSize="13"/>
                                            <TextBlock DockPanel.Dock="Right" Text="VENTANA: 120 s"
                                                       Style="{StaticResource Muted}"/>
                                        </DockPanel>
                                        <Grid Margin="0,2,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="CPU GLOBAL" Style="{StaticResource Muted}"/>
                                                <TextBlock Text="{Binding CpuText}" FontSize="20"
                                                           FontWeight="Bold" Foreground="#168BFF"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="MEMORIA FÍSICA" Style="{StaticResource Muted}"/>
                                                <TextBlock Text="{Binding MemoryText}" FontSize="20"
                                                           FontWeight="Bold" Foreground="#42D392"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Height="112">
                                            <ctl:Sparkline Values="{Binding CpuHistory}"
                                                           Stroke="{StaticResource AccentBrush}"
                                                           Margin="0,0,0,46"/>
                                            <ctl:Sparkline Values="{Binding MemoryHistory}"
                                                           Stroke="{StaticResource OkBrush}"
                                                           Margin="0,48,0,0"/>
                                        </Grid>
                                        <TextBlock Text="Fuentes: GetSystemTimes y GlobalMemoryStatusEx. FPS, 1% lows, frametime, GPU y temperatura no están disponibles en esta medición."
                                                   Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Card}"
                                        Padding="12">
                                    <Grid>
                                        <Ellipse Width="142" Height="142"
                                                 Stroke="#184C80" StrokeThickness="10"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                        <Ellipse Width="126" Height="126"
                                                 Stroke="#168BFF" StrokeThickness="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                        <Button x:Name="AnalyzeSystemButton"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="AnalyzeRequested_Click"
                                                ToolTip="Ejecutar el análisis existente de hardware y Windows">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="28" Foreground="#168BFF"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="ANALIZAR"
                                                           FontWeight="Bold" FontSize="14"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Sistema" FontSize="11"
                                                           Foreground="#A5B1C0"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="ESTADO DE TELEMETRÍA"
                                                   Style="{StaticResource CardTitle}" FontSize="13"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="#42D392" FontSize="11"
                                                   FontWeight="SemiBold" Margin="0,2,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Sensors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <Ellipse Width="7" Height="7" Margin="0,3,8,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#F5B84B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Fill" Value="#42D392"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Name}" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Source}" FontSize="9"
                                                                   Foreground="#7F8B99"
                                                                   DockPanel.Dock="Right"
                                                                   Margin="5,0,0,0"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="VER DIAGNÓSTICO"
                                                Style="{StaticResource SmallAction}"
                                                HorizontalAlignment="Right"
                                                Click="NavigateDiagnosis_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3" Margin="-5,2,-5,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="ACCESOS RÁPIDOS" Style="{StaticResource CardTitle}"/>
                                        <UniformGrid Columns="3">
                                            <Button Content="ANALIZAR&#10;SISTEMA"
                                                    Style="{StaticResource SmallAction}"
                                                    Click="AnalyzeRequested_Click"/>
                                            <Button Content="CONTROL&#10;CENTER"
                                                    Style="{StaticResource SmallAction}"
                                                    Click="NavigateControlCenter_Click"/>
                                            <Button Content="LIVE&#10;MONITOR"
                                                    Style="{StaticResource SmallAction}"
                                                    Click="NavigateLiveMonitor_Click"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="ABRIR →"
                                                Style="{StaticResource SmallAction}"
                                                VerticalAlignment="Center"
                                                Click="NavigateGameOptimizer_Click"/>
                                        <StackPanel>
                                            <TextBlock Text="GAME OPTIMIZER · CS2"
                                                       Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Gestor reversible de autoexec.cfg"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="Configuración acotada · backup · confirmación · sin promesas de FPS"
                                                       Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="INFORMACIÓN DEL EQUIPO"
                                                   Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{Binding Hardware.CpuName, TargetNullValue='CPU: No disponible'}"
                                                   FontSize="10"/>
                                        <TextBlock Text="{Binding GpuLines[0], TargetNullValue='GPU: No disponible'}"
                                                   FontSize="10" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding RamText, StringFormat='RAM: {0}'}"
                                                   FontSize="10" Margin="0,4,0,0"/>
                                        <TextBlock Text="Monitor: tasa de refresco no medida"
                                                   Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Expander x:Name="DiagnosticDetails" Grid.Row="4"
                                      Header="DETALLE DE DIAGNÓSTICO Y EVIDENCIA"
                                      Foreground="#D7E0EA" Margin="4,10,4,4">
                                <StackPanel Margin="0,8,0,0">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock x:Name="DiagnosticSectionTitle"
                                                       Text="ANÁLISIS GENERAL DE SOLO LECTURA"
                                                       Style="{StaticResource CardTitle}"/>
                                            <Button Content="ANALIZAR SISTEMA"
                                                    x:Name="AnalyzeSystemDetailButton"
                                                    Style="{StaticResource SmallAction}"
                                                    HorizontalAlignment="Left"
                                                    Click="AnalyzeRequested_Click"/>
                                            <TextBlock x:Name="AnalyzeSystemStatus"
                                                       Text="Preparado para analizar el hardware y Windows."
                                                       TextWrapping="Wrap" Foreground="#A5B1C0"
                                                       Margin="2,6,2,8"/>
                                            <ItemsControl x:Name="SystemDiagnosticItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource DiagnosticItem}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Severity}" Foreground="#F5B84B"
                                                                           Margin="0,4"/>
                                                                <TextBlock Text="{Binding Explanation}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}"
                                                                           Margin="0,5,0,0"/>
                                                                <TextBlock Text="{Binding Recommendation}" FontSize="11"
                                                                           Margin="0,5,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Findings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource DiagnosticItem}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,6">
                                                                    <Run Text="{Binding Severity}"/>
                                                                    <Run Text=" · Confianza "/>
                                                                    <Run Text="{Binding Confidence, StringFormat={}{0:P0}}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding TechnicalExplanation}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Limitations, StringFormat=Limitaciones: {0}}"
                                                                           Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Columns="2">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="PUNTAJE · SIN DATOS INVENTADOS"
                                                           Style="{StaticResource CardTitle}"/>
                                                <ItemsControl ItemsSource="{Binding Score}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,4">
                                                                <TextBlock Text="{Binding ValueText}"
                                                                           DockPanel.Dock="Right"
                                                                           Foreground="#168BFF" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Sin puntaje global hasta disponer de fuentes compatibles."
                                                           Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="RECOMENDACIONES"
                                                           Style="{StaticResource CardTitle}"/>
                                                <ItemsControl ItemsSource="{Binding Recommendations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource DiagnosticItem}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Rationale}" FontSize="11" Margin="0,4,0,0"/>
                                                                    <TextBlock Text="{Binding ExpectedBenefit, StringFormat=Beneficio esperado: {0}}"
                                                                               Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="El motor de decisiones adaptativas no está conectado; no hay recomendaciones automáticas."
                                                           Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="FUENTES DISPONIBLES"
                                                       Style="{StaticResource CardTitle}"/>
                                            <ItemsControl ItemsSource="{Binding Sensors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="2,3">
                                                            <TextBlock Text="{Binding IsActive, StringFormat={}{0}}"
                                                                       Foreground="#42D392" Width="40"/>
                                                            <TextBlock Text="{Binding Name}" Width="230"/>
                                                            <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CpuStatsText, StringFormat=CPU: {0}}"
                                                       Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding MemStatsText, StringFormat=RAM: {0}}"
                                                       Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SessionText}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Control Center">
                    <views:EvoControlCenterWindow x:Name="ControlCenterPanel"/>
                </TabItem>
                <TabItem Header="Módulo">
                    <Grid>
                    <views:EvoStandardPage x:Name="ModuleInfoPage"
                                           PageTitle="MÓDULO EVO"
                                           Subtitle="Estado real y alcance del módulo seleccionado.">
                        <views:EvoStandardPage.PageContent>
                            <StackPanel>
                                <Border Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="18" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="ESTADO DE IMPLEMENTACIÓN"
                                                   Foreground="{StaticResource DimBrush}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ModuleStatus, RelativeSource={RelativeSource AncestorType={x:Type views:EvoStandardPage}}}"
                                                   Foreground="{Binding ModuleStatusBrush, RelativeSource={RelativeSource AncestorType={x:Type views:EvoStandardPage}}}"
                                                   DockPanel.Dock="Right"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding ModuleStatusDetails, RelativeSource={RelativeSource AncestorType={x:Type views:EvoStandardPage}}}"
                                               FontSize="13" Margin="0,12,0,0"/>
                                </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="COMPONENTE / LÍMITE ACTUAL"
                                               Foreground="{StaticResource DimBrush}"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ModuleComponent, RelativeSource={RelativeSource AncestorType={x:Type views:EvoStandardPage}}}"
                                               FontSize="12" Margin="0,8,0,0"/>
                                    <TextBlock Text="Esta ficha informa el estado real del módulo; no ejecuta acciones ni sustituye un componente pendiente."
                                               Foreground="{StaticResource DimBrush}"
                                               FontSize="11" Margin="0,10,0,0"/>
                                </StackPanel>
                                </Border>
                            </StackPanel>
                        </views:EvoStandardPage.PageContent>
                    </views:EvoStandardPage>
                    <views:NetworkDiagnosisPanel x:Name="NetworkDiagnosisPanel"
                                                 Visibility="Collapsed"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Limpieza avanzada">
                    <views:EvoSystemCleanerPanel x:Name="SystemCleanerPanel"/>
                </TabItem>
                <TabItem Header="Historial">
                    <views:EvoHistoryPanel x:Name="HistoryPanel"/>
                </TabItem>
            </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#080B10"
                BorderBrush="#222B35" BorderThickness="0,1,0,0"
                Padding="16,5" x:Name="BottomBar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TELEMETRÍA" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                               Foreground="#B8C2D0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Punto de restauración: estado no disponible"
                           FontSize="10" Foreground="#96A3B2"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Cambios pendientes: estado no disponible"
                           FontSize="10" Foreground="#96A3B2"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
