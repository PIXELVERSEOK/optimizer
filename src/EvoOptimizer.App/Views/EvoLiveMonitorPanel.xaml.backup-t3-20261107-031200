<UserControl x:Class="EvoOptimizer.App.Views.EvoLiveMonitorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D1117"
             MinWidth="700">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="MetricTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,7,0,4"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#30363D"/>
            <Setter Property="Foreground" Value="#2F81F7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Cabecera -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="EVO LIVE MONITOR"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="Telemetría en tiempo real y diagnóstico de arquitectura"
                               Foreground="#8B949E"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="INICIAR"
                            Click="StartMonitoring_Click"/>
                    <Button Content="DETENER"
                            Background="#9E3A38"
                            Click="StopMonitoring_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- Banner de Hardware Objetivo y Topología -->
            <Border Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="INTELIGENCIA DE HARDWARE"
                                   Foreground="#58A6FF"
                                   FontWeight="Bold"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding TopologySummary, Mode=OneWay}"
                                   DockPanel.Dock="Right"
                                   Foreground="#E6EDF3"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </DockPanel>
                    <TextBlock Text="{Binding GamingConfigSummary, Mode=OneWay}"
                               Foreground="#8B949E"
                               FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Barra de estado y Cuello de botella -->
            <Border Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="ESTADO DEL SISTEMA"
                                   Foreground="#8B949E"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <TextBlock Text="{Binding SystemHealth, Mode=OneWay}"
                                       FontWeight="Bold"
                                       Foreground="#3FB950"
                                       Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding MonitorStatus, Mode=OneWay}"
                                       Foreground="#58A6FF"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="#30363D" Margin="0,4,0,8"/>

                    <DockPanel>
                        <TextBlock Text="CUELLO DE BOTELLA IDENTIFICADO"
                                   Foreground="#D29922"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding PrimaryBottleneckText, Mode=OneWay}"
                                   DockPanel.Dock="Right"
                                   Foreground="#F0883E"
                                   FontWeight="Bold"
                                   FontSize="12"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Métricas en cuadrícula 3x2 -->
            <UniformGrid Columns="3" Rows="2">

                <!-- CPU Sistema -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="CPU DEL SISTEMA"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding SystemCpuPercent, Mode=OneWay, StringFormat={}{0:F1}%}"
                                   Style="{StaticResource MetricValue}"/>
                        <ProgressBar Value="{Binding SystemCpuPercent, Mode=OneWay}"
                                     Maximum="100"/>
                        <TextBlock Text="Total procesadores lógicos"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CPU CS2 -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="CPU DE CS2"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding Cs2CpuPercent, StringFormat={}{0:F1}%, Mode=OneWay, TargetNullValue='No en ejecución'}"
                                   Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="{Binding Cs2ProcessCount, StringFormat={}Instancias CS2: {0}, Mode=OneWay}"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- GPU Intel UHD -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="GPU (INTEL UHD 3D)"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding GpuUsagePercent, Mode=OneWay, StringFormat={}{0:F1}%, TargetNullValue='0.0%'}"
                                   Style="{StaticResource MetricValue}"/>
                        <ProgressBar Value="{Binding GpuUsagePercent, Mode=OneWay, TargetNullValue=0}"
                                     Maximum="100"/>
                        <TextBlock Text="{Binding GpuSharedMemoryMb, StringFormat={}VRAM Compartida: {0:F0} MB, Mode=OneWay, TargetNullValue='VRAM Dinámica'}"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- RAM Física -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MEMORIA RAM FÍSICA"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:F1}%, Mode=OneWay}"
                                   Style="{StaticResource MetricValue}"/>
                        <ProgressBar Value="{Binding MemoryUsagePercent, Mode=OneWay}"
                                     Maximum="100"/>
                        <TextBlock Text="{Binding AvailableMemoryMb, StringFormat={}{0:F0} MB libres, Mode=OneWay}"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Commit y Paginación -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MEMORIA COMPROMETIDA (COMMIT)"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding CommitUsedMb, StringFormat={}{0:F0} MB, Mode=OneWay}"
                                   Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="{Binding CommitLimitMb, StringFormat={}Límite Commit: {0:F0} MB, Mode=OneWay}"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Memoria CS2 -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="WORKING SET CS2"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding Cs2MemoryMb, StringFormat={}{0:F0} MB, Mode=OneWay, TargetNullValue='0 MB'}"
                                   Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="Memoria física dedicada a cs2.exe"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Actividad de procesos y Competidores -->
            <Border Style="{StaticResource MetricCard}"
                    Margin="5,10,5,5">
                <StackPanel>
                    <TextBlock Text="PROCESOS COMPETIDORES EN TIEMPO REAL"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding TopProcesses, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               Foreground="#E6EDF3"/>
                                    <TextBlock Text="{Binding ProcessId, StringFormat={} (PID: {0}), Mode=OneWay}"
                                               Foreground="#8B949E"
                                               FontSize="11"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:F1}% CPU, Mode=OneWay}"
                                                   Foreground="#58A6FF"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding MemoryMb, StringFormat={}{0:F0} MB RAM, Mode=OneWay}"
                                                   Foreground="#8B949E"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Sin competidores detectados (CPU en carga normal)."
                               Foreground="#8B949E"
                               FontSize="11"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TopProcesses.Count, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Separator Background="#30363D" Margin="0,10,0,8"/>

                    <DockPanel>
                        <TextBlock Text="{Binding ActiveProcessCount, StringFormat={}Total procesos activos: {0}, Mode=OneWay}"
                                   Foreground="#8B949E"
                                   FontSize="11"/>
                        <TextBlock Text="{Binding LastUpdated, StringFormat={}Actualizado: {0:HH:mm:ss}, Mode=OneWay}"
                                   DockPanel.Dock="Right"
                                   Foreground="#8B949E"
                                   FontSize="11"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Anomalías detectadas -->
            <TextBlock Text="ANOMALÍAS DETECTADAS"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="5,16,5,6"/>

            <Border Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    Margin="5">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Anomalies, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#30363D"
                                        BorderThickness="0,0,0,1"
                                        Padding="7">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Severity, Mode=OneWay}"
                                                       DockPanel.Dock="Right"
                                                       Foreground="#D29922"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Evidence, Mode=OneWay}"
                                                   Foreground="#8B949E"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Recommendation, Mode=OneWay}"
                                                   Foreground="#58A6FF"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Sin anomalías registradas."
                               Foreground="#8B949E"
                               HorizontalAlignment="Center"
                               Margin="8">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Anomalies.Count, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Recomendaciones adaptativas del motor Core -->
            <TextBlock Text="DECISIONES ADAPTATIVAS BASADAS EN EVIDENCIA"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="5,16,5,6"/>

            <Border Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    Margin="5">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding OptimizationRecommendations, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#30363D"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Foreground="#D29922">
                                                <Run Text="{Binding Priority, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Risk, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Explanation, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="#8B949E"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="#3FB950"
                                                   Margin="0,3,0,0">
                                            <Run Text="Confianza: "/>
                                            <Run Text="{Binding ConfidencePercent, Mode=OneWay, StringFormat={}{0:F0}%}"/>
                                            <Run Text=" · Reversible: "/>
                                            <Run Text="{Binding IsReversible, Mode=OneWay}"/>
                                            <Run Text=" · Requiere aprobación: "/>
                                            <Run Text="{Binding RequiresUserApproval, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Sin decisiones pendientes. Se evalúan señales de anomalías y configuración de Windows."
                               Foreground="#8B949E"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="8">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OptimizationRecommendations.Count, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Alertas del sistema -->
            <TextBlock Text="ALERTAS DEL SISTEMA"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="5,16,5,6"/>

            <Border Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    Margin="5">
                <ItemsControl ItemsSource="{Binding Alerts, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="#D29922"
                                       TextWrapping="Wrap"
                                       Margin="4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
