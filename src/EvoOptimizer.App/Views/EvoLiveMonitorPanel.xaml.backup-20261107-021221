<UserControl x:Class="EvoOptimizer.App.Views.EvoLiveMonitorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D1117"
             MinWidth="700">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="MetricTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,9,0,4"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="#30363D"/>
            <Setter Property="Foreground" Value="#2F81F7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">

            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="EVO LIVE MONITOR"
                               FontSize="23"
                               FontWeight="Bold"/>
                    <TextBlock Text="Telemetría y diagnóstico adaptativo"
                               Foreground="#8B949E"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="INICIAR"
                            Click="StartMonitoring_Click"/>
                    <Button Content="DETENER"
                            Background="#9E3A38"
                            Click="StopMonitoring_Click"/>
                </StackPanel>
            </DockPanel>

            <Border Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Text="ESTADO DEL SISTEMA"
                               Foreground="#8B949E"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <TextBlock Text="{Binding SystemHealth}"
                                   FontWeight="Bold"
                                   Foreground="#3FB950"
                                   Margin="0,0,18,0"/>
                        <TextBlock Text="{Binding MonitorStatus}"
                                   Foreground="#58A6FF"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="2" Rows="2">

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="CPU DEL SISTEMA"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding SystemCpuPercent, StringFormat={}{0:F1}%}"
                                   Style="{StaticResource MetricValue}"/>
                        <ProgressBar Value="{Binding SystemCpuPercent}"
                                     Maximum="100"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="CPU DE CS2"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding Cs2CpuPercent, StringFormat={}{0:F1}%}"
                                   Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="Consumo normalizado entre procesadores lógicos"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MEMORIA RAM"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:F1}%}"
                                   Style="{StaticResource MetricValue}"/>
                        <ProgressBar Value="{Binding MemoryUsagePercent}"
                                     Maximum="100"/>
                        <TextBlock Text="{Binding AvailableMemoryMb, StringFormat={}{0:F0} MB disponibles}"
                                   Foreground="#8B949E"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MEMORIA DE CS2"
                                   Style="{StaticResource MetricTitle}"/>
                        <TextBlock Text="{Binding Cs2MemoryMb, StringFormat={}{0:F0} MB}"
                                   Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="{Binding Cs2ProcessCount, StringFormat={}Procesos CS2: {0}}"
                                   Foreground="#8B949E"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <Border Style="{StaticResource MetricCard}"
                    Margin="5,12,5,5">
                <StackPanel>
                    <TextBlock Text="ACTIVIDAD DEL SISTEMA"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <DockPanel Margin="0,4">
                        <TextBlock Text="Procesos activos"
                                   Foreground="#8B949E"/>
                        <TextBlock Text="{Binding ActiveProcessCount}"
                                   DockPanel.Dock="Right"
                                   FontWeight="Bold"/>
                    </DockPanel>

                    <DockPanel Margin="0,4">
                        <TextBlock Text="Procesos de CS2"
                                   Foreground="#8B949E"/>
                        <TextBlock Text="{Binding Cs2ProcessCount}"
                                   DockPanel.Dock="Right"
                                   FontWeight="Bold"/>
                    </DockPanel>

                    <DockPanel Margin="0,4">
                        <TextBlock Text="Última actualización"
                                   Foreground="#8B949E"/>
                        <TextBlock Text="{Binding LastUpdated, StringFormat={}{0:HH:mm:ss}}"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="ANOMALÍAS DETECTADAS"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="5,20,5,8"/>

            <Border Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    Margin="5">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Anomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#30363D"
                                        BorderThickness="0,0,0,1"
                                        Padding="7">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Severity}"
                                                       DockPanel.Dock="Right"
                                                       Foreground="#D29922"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Evidence}"
                                                   Foreground="#8B949E"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Sin anomalías registradas."
                               Foreground="#8B949E"
                               HorizontalAlignment="Center"
                               Margin="8">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Anomalies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="ALERTAS DEL SISTEMA"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="5,20,5,8"/>

            <Border Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    Margin="5">
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="#D29922"
                                       TextWrapping="Wrap"
                                       Margin="4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
