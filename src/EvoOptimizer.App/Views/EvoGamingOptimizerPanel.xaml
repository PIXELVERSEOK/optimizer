<UserControl x:Class="EvoOptimizer.App.Views.EvoGamingOptimizerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0" Margin="4,0,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EVO GAMING OPTIMIZER" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Detección real del entorno y de juegos instalados. Perfiles con cambios explicados; nada se aplica sin autorización en el Game Booster."
                               Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateText}"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="ANALIZAR ENTORNO" Click="AnalyzeEnvironment_Click"
                            IsEnabled="{Binding CanAnalyze}" Margin="0,0,6,0"/>
                    <Button Content="DETECTAR JUEGOS" Click="ScanGames_Click"
                            IsEnabled="{Binding CanAnalyze}" Margin="0,0,6,0"/>
                    <Button Content="AGREGAR JUEGO MANUAL" Click="AddManualGame_Click"/>
                </StackPanel>
            </Grid>

            <!-- Entorno detectado -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="-4,0,-4,6">
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CpuSummary}" Style="{StaticResource DimText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MEMORIA" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding MemorySummary}" Style="{StaticResource DimText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding GpuSummary}" Style="{StaticResource DimText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="ALMACENAMIENTO" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding StorageSummary}" Style="{StaticResource DimText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="ENERGÍA" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding PowerSummary}" Style="{StaticResource DimText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="CONFIGURACIÓN GAMING · SEGUNDO PLANO" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding GamingConfigSummary}" Style="{StaticResource DimText}"/>
                        <TextBlock Text="{Binding BackgroundSummary}" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recomendación -->
            <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
                <TextBlock Text="{Binding RecommendationText}"
                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
            </Border>

            <!-- Juegos + perfiles -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,4,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="JUEGOS DETECTADOS" Style="{StaticResource SectionTitle}"/>
                            <Button DockPanel.Dock="Right" Content="QUITAR MANUAL"
                                    Click="RemoveManualGame_Click" HorizontalAlignment="Right"
                                    FontSize="10" Padding="8,3"/>
                        </DockPanel>
                        <ListBox Height="170"
                                 ItemsSource="{Binding Games}"
                                 SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Launcher, StringFormat=' · {0}'}"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding SelectedGameStatus}"
                                   Style="{StaticResource DimText}" Margin="0,6,0,0"/>
                        <ItemsControl ItemsSource="{Binding ScanNotes}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10"
                                               Foreground="{StaticResource DimBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="12" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PERFILES INTELIGENTES" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <ListBox Height="92"
                                 ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding SelectedProfile.Description}"
                                   Style="{StaticResource DimText}" Margin="0,6,0,0"/>
                        <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="{Binding Explanation}" FontSize="10"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Cambios planificados -->
            <Border Grid.Row="4" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="QUÉ CAMBIARÍA (SIN APLICAR NADA TODAVÍA)"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding PlannedChangesText}" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Handoff al Booster -->
            <DockPanel Grid.Row="5" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Style="{StaticResource DimText}"
                           Text="El Optimizer analiza y recomienda; el Booster aplica con autorización y restaura al terminar."/>
                <Button DockPanel.Dock="Right" Content="PREPARAR BOOST →"
                        Click="PrepareBoost_Click" HorizontalAlignment="Right"
                        Background="{StaticResource AccentSubtleBrush}"
                        FontWeight="Bold" Padding="18,8"/>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>