<UserControl x:Class="EvoOptimizer.App.Views.EvoTweakPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EvoOptimizer.App.Views"
             xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
             Background="#090C10">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#171E27"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2B7FEA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Background" Value="#2B7FEA"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Background" Value="#7E363C"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="#D7E0EA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#35404B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TweakSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Width="42" Height="22"
                                    Background="#35404B" BorderBrush="#4B5866"
                                    BorderThickness="1" CornerRadius="11"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16"
                                     Fill="#E8EDF4" HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#176B4B"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#42D392"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <data:CollectionViewSource x:Key="GroupedTweakRows" Source="{Binding TweakView}">
            <data:CollectionViewSource.GroupDescriptions>
                <data:PropertyGroupDescription PropertyName="CategoryLabel"/>
            </data:CollectionViewSource.GroupDescriptions>
        </data:CollectionViewSource>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#171E27"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#11161D"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A9EFF"/>
            <Setter Property="Margin" Value="4,10,4,6"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#93A0AF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SpecValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#090C10"/>
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#E8EDF4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#11161D"/>
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#090C10"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#93A0AF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4A9EFF"/>
                                <Setter Property="Foreground" Value="#E8EDF4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E8EDF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#11161D"/>
            <Setter Property="Foreground" Value="#4A9EFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="TweakGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#090C10"/>
            <Setter Property="RowBackground" Value="#11161D"/>
            <Setter Property="AlternatingRowBackground" Value="#11161D"/>
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#171E27"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ESCÁNER · TWEAKS · DEBLOAT"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#E8EDF4"/>
            <TextBlock Style="{StaticResource Muted}"
                       Margin="0,2,0,0"
                       Text="Escáner de solo lectura, tweaks de registro reversibles y debloat UWP con restauración por AppxManifest. Ninguna escritura ocurre sin confirmación explícita."/>
        </StackPanel>

        <TabControl x:Name="TweakSections" Grid.Row="1" Margin="0,10,0,0">

            <!-- ══════════════ SCANNER ══════════════ -->
            <TabItem Header="SCANNER">
                <Grid Margin="6,10,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button x:Name="ScannerRunButton"
                                Style="{StaticResource AccentButton}"
                                Content="ESCANEAR EQUIPO"
                                IsEnabled="{Binding CanRunScanner}"
                                Click="ScannerRun_Click"/>
                        <Button Style="{StaticResource SmallButton}"
                                Content="EXPORTAR INFORME"
                                Click="ScannerExport_Click"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Text="{Binding ScannerAtText, TargetNullValue='Sin escaneo'}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Margin="4,8,4,4"
                               FontWeight="SemiBold"
                               Foreground="#D29922"
                               Text="{Binding ScannerStatusText}"/>

                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,4,0,4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PROCESADOR" Style="{StaticResource Muted}"/>
                                <TextBlock Style="{StaticResource SpecValue}" Text="{Binding ScannerCpuText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="GRÁFICOS" Style="{StaticResource Muted}"/>
                                <TextBlock Style="{StaticResource SpecValue}" Text="{Binding ScannerGpuText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MEMORIA" Style="{StaticResource Muted}"/>
                                <TextBlock Style="{StaticResource SpecValue}" Text="{Binding ScannerMemoryText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ALMACENAMIENTO" Style="{StaticResource Muted}"/>
                                <TextBlock Style="{StaticResource SpecValue}" Text="{Binding ScannerStorageText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PANTALLA" Style="{StaticResource Muted}"/>
                                <TextBlock Style="{StaticResource SpecValue}" Text="{Binding ScannerDisplayText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SISTEMA" Style="{StaticResource Muted}"/>
                                <TextBlock Style="{StaticResource SpecValue}" Text="{Binding ScannerOsText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PLACA / BIOS" Style="{StaticResource Muted}"/>
                                <TextBlock Style="{StaticResource SpecValue}" Text="{Binding ScannerTopologyText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="REFERENCIA DEL BRIEF" Style="{StaticResource Muted}"/>
                                <TextBlock Style="{StaticResource SpecValue}"
                                           FontSize="10"
                                           Foreground="#93A0AF"
                                           Text="{Binding ScannerBriefText}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="3"
                              Style="{StaticResource TweakGrid}"
                              ItemsSource="{Binding ScannerRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Category}" Width="150"/>
                            <DataGridTextColumn Header="DATO" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="VALOR DETECTADO" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="ORIGEN" Binding="{Binding Source}" Width="220"/>
                            <DataGridTextColumn Header="CONFIABILIDAD" Binding="{Binding Confidence}" Width="150"/>
                            <DataGridTextColumn Header="MEDIDO" Binding="{Binding MeasuredAtText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════ TWEAKS ══════════════ -->
            <TabItem Header="TWEAKS">
                <views:EvoStandardPage x:Name="TweakCatalogPage"
                                       PageTitle="Catálogo de Optimización"
                                       Subtitle="Ajustes disponibles en el catálogo real de EVO. Los estados aparecen después de leer el registro; cada cambio conserva confirmación, verificación y rollback.">
                    <views:EvoStandardPage.ActionBarContent>
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource AccentButton}"
                                        Content="ESCANEAR TWEAKS"
                                        IsEnabled="{Binding CanScanTweaks}"
                                        Click="TweakScan_Click"/>
                                <TextBox Width="210"
                                         Margin="6,3"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding TweakSearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         ToolTip="Buscar por nombre, descripción, clave o estado"/>
                                <ComboBox Width="170"
                                          Margin="6,3"
                                          ItemsSource="{Binding TweakCategories}"
                                          SelectedItem="{Binding SelectedTweakCategory, Mode=TwoWay}"
                                          ToolTip="Filtrar por una categoría existente del catálogo"/>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="APLICAR RIESGO BAJO"
                                        Click="TweakApplyAllLowRisk_Click"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="REVERTIR TODOS"
                                        Click="TweakRollbackAll_Click"/>
                            </WrapPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="#D29922"
                                       Margin="5,5,5,0"
                                       Text="{Binding TweakStatusText}"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Margin="5,3,5,0"
                                       Text="{Binding TweakCountsText}"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Margin="5,2,5,0"
                                       Text="{Binding TweakJournalHint}"/>
                        </StackPanel>
                    </views:EvoStandardPage.ActionBarContent>
                    <views:EvoStandardPage.PageContent>
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Las acciones de aplicación y reversión solicitan confirmación. EVO guarda el valor original, verifica la escritura y restaura el estado previo si la relectura falla."/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedTweakRows}}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="{x:Type GroupItem}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                <Expander IsExpanded="True" Margin="0,0,0,8">
                                                                    <Expander.Header>
                                                                        <DockPanel>
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="12"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#4A9EFF"/>
                                                                            <TextBlock Text="{Binding ItemCount, StringFormat= · {0} ajustes}"
                                                                                       Foreground="#93A0AF"
                                                                                       FontSize="10"/>
                                                                        </DockPanel>
                                                                    </Expander.Header>
                                                                    <ItemsPresenter/>
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#11161D"
                                                    BorderBrush="#26303B"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="12"
                                                    Margin="0,3,0,5"
                                                    PreviewMouseLeftButtonUp="TweakRow_PreviewMouseLeftButtonUp">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            Click="TweakDetails_Click">
                                                        <StackPanel>
                                                            <WrapPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#E8EDF4"
                                                                           VerticalAlignment="Center"/>
                                                                <Border CornerRadius="8"
                                                                        Padding="7,3"
                                                                        Margin="9,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#303943"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RiskLabel}" Value="Riesgo bajo">
                                                                                    <Setter Property="Background" Value="#183C2E"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding RiskLabel}" Value="Riesgo medio">
                                                                                    <Setter Property="Background" Value="#46391E"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding RiskLabel}" Value="Riesgo alto">
                                                                                    <Setter Property="Background" Value="#4A292C"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding RiskLabel}"
                                                                               FontSize="9"
                                                                               FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#C3CCD6"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding RiskLabel}" Value="Riesgo bajo">
                                                                                        <Setter Property="Foreground" Value="#42D392"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding RiskLabel}" Value="Riesgo medio">
                                                                                        <Setter Property="Foreground" Value="#F5B84B"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding RiskLabel}" Value="Riesgo alto">
                                                                                        <Setter Property="Foreground" Value="#FF8B72"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </WrapPanel>
                                                            <DockPanel Margin="0,5,0,0">
                                                                <TextBlock Text="{Binding StateLabel}"
                                                                           Foreground="{Binding StateColor}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           DockPanel.Dock="Right"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Foreground="#93A0AF"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Description}"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Grid.Column="1"
                                                            Margin="12,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Estado detectado en el escaneo del registro">
                                                        <ToggleButton IsChecked="{Binding IsApplied, Mode=OneWay}"
                                                                      Click="TweakToggle_Click">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource TweakSwitch}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsApplied}" Value="False"/>
                                                                                <Condition Binding="{Binding CanApply}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsApplied}" Value="True"/>
                                                                                <Condition Binding="{Binding CanRollback}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="&#xE712;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="8,5"
                                                            ToolTip="Acciones analíticas disponibles para este tweak"
                                                            Click="TweakMenu_Click">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Medir línea base"
                                                                          IsEnabled="False"
                                                                          ToolTip="La medición de referencia no está conectada al catálogo de tweaks."/>
                                                                <MenuItem Header="Medir posterior"
                                                                          IsEnabled="False"
                                                                          ToolTip="La medición posterior no está conectada al catálogo de tweaks."/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </views:EvoStandardPage.PageContent>
                    <views:EvoStandardPage.ContextualSidePanelContent>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button Content="&#xE711;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Style="{StaticResource GhostButton}"
                                        DockPanel.Dock="Right"
                                        ToolTip="Cerrar detalles"
                                        Click="TweakDetailsClose_Click"/>
                                <TextBlock Text="DETALLES DEL TWEAK"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#4A9EFF"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding StateLabel}"
                                       Foreground="{Binding StateColor}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,5,0,12"/>
                            <TextBlock Text="QUÉ HACE" Style="{StaticResource Muted}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Description}" Margin="0,5,0,12"/>
                            <TextBlock Text="BENEFICIO ESPERADO" Style="{StaticResource Muted}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Benefit}" Margin="0,5,0,12"/>
                            <TextBlock Text="RIESGO" Style="{StaticResource Muted}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RiskLabel}" Margin="0,5,0,12"/>
                            <TextBlock Text="RUTA DE REGISTRO" Style="{StaticResource Muted}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RegistryLocation}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,12"
                                       ToolTip="{Binding RegistryLocation}"/>
                            <TextBlock Text="{Binding CurrentValueLabel, StringFormat=Valor actual: {0}}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding DesiredLabel, StringFormat=Valor propuesto: {0}}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding EvidenceSource, StringFormat=Origen: {0}}"
                                       Style="{StaticResource Muted}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MeasuredAtText, StringFormat=Leído: {0}}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </views:EvoStandardPage.ContextualSidePanelContent>
                </views:EvoStandardPage>
            </TabItem>

            <!-- ══════════════ DEBLOAT ══════════════ -->
            <TabItem Header="DEBLOAT">
                <Grid Margin="6,10,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button x:Name="DebloatScanButton"
                                Style="{StaticResource AccentButton}"
                                Content="ESCANEAR APPS UWP"
                                IsEnabled="{Binding CanScanDebloat}"
                                Click="DebloatScan_Click"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Text="{Binding DebloatScannedAtText, TargetNullValue='Sin escaneo'}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="4,8,4,0">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#D29922"
                                   Text="{Binding DebloatStatusText}"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Margin="0,4,0,0"
                                   Text="{Binding DebloatCountsText}"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Style="{StaticResource Card}"
                            Margin="4,8,4,4"
                            Padding="10">
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="EVO sólo quita paquetes catalogados y nunca toca la lista protegida (Store, runtime VCLibs/UI.Xaml/.NET, identidad AAD, Defender/SecHealthUI, Shell/StartMenu, Game Bar provider, Xbox services). El quite es por usuario con Remove-AppxPackage y queda registrado con PackageFullName e InstallLocation para restaurarlo con Add-AppxPackage -Register."/>
                    </Border>

                    <DataGrid Grid.Row="3"
                              Style="{StaticResource TweakGrid}"
                              ItemsSource="{Binding DebloatView}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ESTADO" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StateColor}"
                                                CornerRadius="8"
                                                Padding="7,3"
                                                Margin="3"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StateLabel}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="APLICACIÓN" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="PAQUETE DETECTADO" Binding="{Binding PackageLabel}" Width="330"/>
                            <DataGridTextColumn Header="VERSIÓN" Binding="{Binding VersionLabel}" Width="120"/>
                            <DataGridTextColumn Header="POR QUÉ" Binding="{Binding Reason}" Width="320"/>
                            <DataGridTextColumn Header="BENEFICIO" Binding="{Binding Benefit}" Width="250"/>
                            <DataGridTextColumn Header="RIESGO" Binding="{Binding RiskLabel}" Width="110"/>
                            <DataGridTextColumn Header="REINSTALACIÓN" Binding="{Binding ReinstallHint}" Width="300"/>
                            <DataGridTextColumn Header="ESCANEADO" Binding="{Binding ScannedAtLabel}" Width="150"/>
                            <DataGridTemplateColumn Header="ACCIÓN" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallButton}"
                                                    Content="QUITAR"
                                                    Tag="{Binding Id}"
                                                    IsEnabled="{Binding CanRemove}"
                                                    Click="DebloatRemove_Click"/>
                                            <Button Style="{StaticResource SmallButton}"
                                                    Content="RESTAURAR"
                                                    Background="#2B7FEA"
                                                    Tag="{Binding Id}"
                                                    IsEnabled="{Binding CanRestore}"
                                                    Click="DebloatRestore_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
