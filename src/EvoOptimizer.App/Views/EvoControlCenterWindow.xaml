<Window x:Class="EvoOptimizer.App.Views.EvoControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EvoOptimizer.App.Views"
        Title="EVO FPS OPTIMIZER - Control Center"
        Width="1280"
        Height="880"
        MinWidth="950"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#161B22"
                                BorderBrush="#30363D"
                                BorderThickness="1,1,1,0"
                                CornerRadius="7,7,0,0"
                                Margin="2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0D1117"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2F81F7"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl Background="#0D1117" BorderBrush="#30363D" Margin="6">
        <TabItem Header="EVO CONTROL CENTER">
            <views:EvoOptimizationHubPanel x:Name="HubPanel"/>
        </TabItem>
        <TabItem Header="ESCÁNER · TWEAKS · DEBLOAT">
            <views:EvoTweakPanel x:Name="TweakPanel"/>
        </TabItem>
        <TabItem Header="TELEMETRÍA EN VIVO">
            <views:EvoLiveMonitorPanel x:Name="LiveMonitorPanel"/>
        </TabItem>
    </TabControl>
</Window>