<UserControl x:Class="EvoOptimizer.App.Views.EvoControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EvoOptimizer.App.Views"
        Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="0"
                                Margin="2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <TabControl x:Name="ControlCenterSections"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource LineBrush}" Margin="0">
            <TabItem Header="CONTROL CENTER">
                <views:EvoOptimizationHubPanel x:Name="HubPanel"/>
            </TabItem>
            <TabItem Header="SCANNER · TWEAKS · DEBLOAT">
                <views:EvoTweakPanel x:Name="TweakPanel"/>
            </TabItem>
            <TabItem Header="LIVE MONITOR">
                <views:EvoLiveMonitorPanel x:Name="LiveMonitorPanel"/>
            </TabItem>
            <TabItem Header="GAME OPTIMIZER">
                <views:EvoGamingOptimizerPanel x:Name="GamingOptimizerPanel"/>
            </TabItem>
            <TabItem Header="GAME BOOSTER">
                <views:EvoGameBoosterPanel x:Name="GameBoosterPanel"/>
            </TabItem>
    </TabControl>
</UserControl>