<UserControl x:Class="EvoOptimizer.App.Views.NetworkDiagnosisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101720">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <DockPanel Margin="0,0,0,10">
                <Button x:Name="AnalyzeButton"
                        DockPanel.Dock="Right"
                        Content="ANALIZAR RED"
                        Padding="16,8"
                        Background="#2B7FEA"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="Analyze_Click"/>
                <StackPanel>
                    <TextBlock Text="DIAGNÓSTICO DE RED"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#E8EDF4"/>
                    <TextBlock Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="#93A0AF"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="ADAPTADORES"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#4A9EFF"
                       Margin="0,8,0,4"/>
            <ItemsControl ItemsSource="{Binding AdapterRows, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#11161D"
                                BorderBrush="#26303B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,3">
                            <TextBlock Text="{Binding}"
                                       Foreground="#E8EDF4"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding ProbeSummaryText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="#E8EDF4"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>
            <ItemsControl ItemsSource="{Binding Warnings, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#D29922"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Solo lectura: no se modifican DNS, TCP/IP, adaptadores ni rutas. ICMP puede estar filtrado; la falta de respuesta no equivale por sí sola a una falla."
                       Foreground="#93A0AF"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
