<UserControl x:Class="EvoOptimizer.App.Views.EvoGameBoosterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,18,3"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource PanelBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado + estado -->
            <Grid Grid.Row="0" Margin="4,0,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EVO GAME BOOSTER" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource PanelStyle}"
                        Padding="16,8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateText}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>

            <!-- Juego + perfil -->
            <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding GameDisplayText}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="PERFIL" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="220"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedProfileDescription}"
                               Style="{StaticResource DimText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Acciones autorizables -->
            <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="ACCIONES AUTORIZADAS (NINGUNA SE EJECUTA SIN MARCARLA)"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <CheckBox Content="Plan de energía temporal (sólo AC + Equilibrado)"
                                  IsChecked="{Binding ApplyPowerPlan, Mode=TwoWay}"/>
                        <CheckBox Content="GameDVR / Modo Juego (HKCU, reversible)"
                                  IsChecked="{Binding ApplyGamingRegistry, Mode=TwoWay}"/>
                        <CheckBox Content="Prioridad del juego → AboveNormal"
                                  IsChecked="{Binding ApplyGamePriority, Mode=TwoWay}"/>
                        <CheckBox Content="Afinidad del juego (sólo topología híbrida confiable)"
                                  IsChecked="{Binding ApplyGameAffinity, Mode=TwoWay}"/>
                        <CheckBox Content="Relanzar apps cerradas al restaurar"
                                  IsChecked="{Binding RelaunchClosedApps, Mode=TwoWay}"/>
                        <CheckBox Content="Restaurar automáticamente al salir el juego"
                                  IsChecked="{Binding AutoRestoreOnGameExit, Mode=TwoWay}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Candidatos de segundo plano -->
            <Border Grid.Row="3" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="APLICACIONES NO ESENCIALES DETECTADAS"
                                   Style="{StaticResource SectionTitle}"/>
                        <Button DockPanel.Dock="Right" Content="REFRESCAR CANDIDATOS"
                                Click="RefreshCandidates_Click"
                                IsEnabled="{Binding CanRefreshCandidates}"
                                HorizontalAlignment="Right" FontSize="10" Padding="10,4"/>
                    </DockPanel>
                    <DataGrid Height="180" ItemsSource="{Binding Candidates}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROCESO" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:F1}}" Width="70"/>
                            <DataGridTextColumn Header="RAM MB" Binding="{Binding MemoryMb, StringFormat={}{0:F0}}" Width="80"/>
                            <DataGridTemplateColumn Header="BAJAR PRIORIDAD" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding ThrottleSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CERRAR (AUTORIZADO)" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding CloseSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Protegidos por política y nunca listados: Windows, antivirus, controladores, servicios esenciales, audio/red/periféricos, anti-cheats, lanzadores y EVO. El cierre siempre es voluntario (CloseMainWindow); jamás se fuerza la terminación."
                               Style="{StaticResource DimText}" FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- BOOST NOW / RESTORE -->
            <Grid Grid.Row="4" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="BOOST NOW" Click="BoostNow_Click"
                        IsEnabled="{Binding CanBoost}"
                        FontSize="18" FontWeight="Bold" Padding="24,14" Margin="0,0,4,0"
                        Background="{StaticResource AccentSubtleBrush}"/>
                <Button Grid.Column="1" Content="RESTORE SYSTEM" Click="RestoreSystem_Click"
                        IsEnabled="{Binding CanRestore}"
                        FontSize="18" FontWeight="Bold" Padding="24,14" Margin="4,0,0,0"/>
            </Grid>

            <!-- Resultado real -->
            <Border Grid.Row="5" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="RESULTADO DE LA SESIÓN (MEDICIÓN REAL)"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SessionSummary}" Style="{StaticResource DimText}"/>
                    <TextBlock Text="{Binding ResultText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Acciones de la sesión -->
            <Border Grid.Row="6" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="DIARIO DE ACCIONES (WRITE-AHEAD)"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <DataGrid Height="160" ItemsSource="{Binding Actions}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ACCIÓN" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="TIPO" Binding="{Binding Kind}" Width="130"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="ORIGINAL" Binding="{Binding OriginalValue}" Width="110"/>
                            <DataGridTextColumn Header="APLICADO" Binding="{Binding AppliedValue}" Width="110"/>
                            <DataGridTextColumn Header="DETALLE / ERROR" Binding="{Binding Error}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Notas -->
            <Border Grid.Row="7" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="NOTAS DE LA SESIÓN" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding SessionNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="10"
                                           Foreground="{StaticResource DimBrush}" Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>