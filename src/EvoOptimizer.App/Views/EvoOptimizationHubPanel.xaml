<UserControl x:Class="EvoOptimizer.App.Views.EvoOptimizationHubPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#090C10">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#171E27"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2B7FEA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PremiumButtonBase}">
            <Setter Property="Background" Value="#7E363C"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#11161D"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A9EFF"/>
            <Setter Property="Margin" Value="4,14,4,6"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#93A0AF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#93A0AF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#090C10"/>
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#E8EDF4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#11161D"/>
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="Margin" Value="4,6"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#090C10"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#93A0AF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4A9EFF"/>
                                <Setter Property="Foreground" Value="#E8EDF4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E8EDF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#26303B"/>
            <Setter Property="Foreground" Value="#4A9EFF"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#090C10"/>
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="RowBackground" Value="#090C10"/>
            <Setter Property="AlternatingRowBackground" Value="#11161D"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#171E27"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#11161D"/>
            <Setter Property="Foreground" Value="#93A0AF"/>
            <Setter Property="BorderBrush" Value="#26303B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <TabControl x:Name="HubSections" Margin="12">

        <!-- ═══════════════ CONTROL CENTER ═══════════════ -->
        <TabItem Header="CONTROL CENTER">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <DockPanel Margin="4,2,4,10">
                        <StackPanel>
                            <TextBlock Text="EVO PERFORMANCE CONTROL"
                                       FontSize="21"
                                       FontWeight="Bold"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Diagnóstico real, catálogo ejecutable y un único circuito: medir → aplicar → verificar → comparar → conservar o revertir."
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="INICIAR MONITOR" Style="{StaticResource PrimaryButton}"
                                    Click="StartMonitoring_Click"/>
                            <Button Content="DETENER" Background="#A6424A"
                                    Click="StopMonitoring_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Puntaje EVO + estado -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Grid.Column="0">
                            <StackPanel>
                                <TextBlock Text="EVO PERFORMANCE SCORE" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding EvoPerformanceScoreText, Mode=OneWay}"
                                           FontSize="30" FontWeight="Bold" Foreground="#4A9EFF"
                                           Margin="0,6,0,2"/>
                                <TextBlock Text="{Binding EvoPerformanceBreakdownText, Mode=OneWay}"
                                           Style="{StaticResource Muted}"/>
                                <Separator Background="#26303B" Margin="0,8"/>
                                <TextBlock Text="{Binding SystemHealth, Mode=OneWay}"
                                           FontWeight="Bold" Foreground="#3FB950" FontSize="12"/>
                                <TextBlock Text="{Binding PrimaryBottleneckText, Mode=OneWay}"
                                           Foreground="#F0883E" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Column="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="PERFILES DE USO" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ActiveProfile, Mode=OneWay}"
                                               FontWeight="Bold" Foreground="#3FB950" FontSize="11"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="EVERYDAY" Tag="EVERYDAY" Click="Profile_Click"/>
                                    <Button Content="GAMING" Tag="GAMING" Click="Profile_Click"
                                            Background="#2B7FEA"/>
                                    <Button Content="MAXPERFORMANCE" Tag="MAXPERFORMANCE" Click="Profile_Click"
                                            Background="#238636"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ProfileStatusText, Mode=OneWay}"
                                           Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                                <Separator Background="#26303B"/>
                                <CheckBox Content="PERFIL AUTOMÁTICO DE CS2 (prioridad + afinidad, reversible al salir)"
                                          IsChecked="{Binding IsAutoGameProfileEnabled, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding AutoGameProfileStatusText, Mode=OneWay}"
                                           Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Métricas -->
                    <UniformGrid Columns="6" Margin="0,4,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CPU SISTEMA" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding SystemCpuPercent, Mode=OneWay, StringFormat={}{0:F1}%}"
                                           Style="{StaticResource MetricValue}"/>
                                <ProgressBar Value="{Binding SystemCpuPercent, Mode=OneWay}" Maximum="100"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="GPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding GpuUsagePercent, Mode=OneWay, TargetNullValue=UNKNOWN, StringFormat={}{0:F1}%}"
                                           Style="{StaticResource MetricValue}"/>
                                <ProgressBar Value="{Binding GpuUsagePercent, Mode=OneWay}" Maximum="100"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding MemoryUsagePercent, Mode=OneWay, StringFormat={}{0:F1}%}"
                                           Style="{StaticResource MetricValue}"/>
                                <ProgressBar Value="{Binding MemoryUsagePercent, Mode=OneWay}" Maximum="100"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="COMMIT" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding CommitUsedMb, Mode=OneWay, StringFormat={}{0:F0} MB}"
                                           Style="{StaticResource MetricValue}" FontSize="18"/>
                                <TextBlock Text="{Binding CommitLimitMb, Mode=OneWay, StringFormat=Límite {0:F0} MB}"
                                           Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CS2 CPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding Cs2CpuPercent, Mode=OneWay, TargetNullValue=UNKNOWN, StringFormat={}{0:F1}%}"
                                           Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="{Binding Cs2ProcessCount, Mode=OneWay, StringFormat={}{0} procesos}"
                                           Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="VRAM COMPARTIDA" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding GpuSharedMemoryMb, Mode=OneWay, TargetNullValue=UNKNOWN, StringFormat={}{0:F0} MB}"
                                           Style="{StaticResource MetricValue}" FontSize="18"/>
                                <TextBlock Text="{Binding LastUpdated, Mode=OneWay, StringFormat=Actualizado {0:HH:mm:ss}}"
                                           Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Optimizaciones activas -->
                    <TextBlock Text="OPTIMIZACIONES ACTIVAS" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding CatalogCountsText, Mode=OneWay}"
                                       Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ActiveOptimizations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Border Background="{Binding StateColor}"
                                                    CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="10"
                                                           FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource Muted}"
                                                       Width="150"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Sin optimizaciones aplicadas todavía.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#93A0AF"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveOptimizations.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Gobierno de procesos -->
                    <TextBlock Text="GOBIERNO DE PROCESOS (SÓLO PRIORIDAD, NUNCA TERMINA PROCESOS)" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Clasificación de procesos con más carga. Bajar la prioridad usa BelowNormal, nunca High/Realtime; los procesos críticos y desconocidos quedan protegidos."
                                       Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding MemoryPressureStatusText, Mode=OneWay}"
                                       Foreground="#4A9EFF"
                                       FontSize="11"
                                       Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding GovernedProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock Text="{Binding PriorityClass}" Style="{StaticResource Muted}"
                                                           VerticalAlignment="Center" Width="100"/>
                                                <Button Content="BAJAR" Tag="throttle" Click="ProcessAction_Click"
                                                        Background="#9E6A03"/>
                                                <Button Content="RESTAURAR" Tag="restore" Click="ProcessAction_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}" Width="180" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Importance}" Style="{StaticResource Muted}"
                                                       Width="90" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CpuPercent, StringFormat=CPU {0:F1}%}"
                                                       Foreground="#4A9EFF" FontSize="11" Width="80"/>
                                            <TextBlock Text="{Binding MemoryMb, StringFormat=RAM {0:F0} MB}"
                                                       Foreground="#93A0AF" FontSize="11"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══════════════ CATÁLOGO ═══════════════ -->
        <TabItem Header="CATÁLOGO DE OPTIMIZACIONES">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="4,4,4,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="ACTUALIZAR CATÁLOGO" Style="{StaticResource PrimaryButton}"
                                Click="RefreshCatalog_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CATÁLOGO EJECUTABLE" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CatalogStatusText, Mode=OneWay}"
                                   Style="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="4,0,4,8">
                    <TextBlock Text="BUSCAR" Style="{StaticResource MetricLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="210" Margin="8,0,0,0"
                              ItemsSource="{Binding CatalogCategories}"
                              SelectedItem="{Binding SelectedCatalogCategory, Mode=TwoWay}"/>
                    <TextBox Text="{Binding CatalogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="8,0,0,0" ToolTip="Nombre, descripción, ID o categoría"/>
                </DockPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CatalogView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="505">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border Background="{Binding StateColor}"
                                                    CornerRadius="4" Padding="7,2" DockPanel.Dock="Right">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="10"
                                                           FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding CategoryLabel}" Foreground="#4A9EFF"
                                                   FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Muted}"/>

                                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding CurrentState}" FontSize="11"
                                                   Foreground="#D29922" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding ExpectedBenefit}" FontSize="11"
                                                   Foreground="#93A0AF" Margin="0,3,0,0"/>

                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding RiskLabel}" FontSize="10"
                                                       Foreground="#93A0AF" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Confidence, StringFormat=Confianza: {0}}"
                                                       FontSize="10" Foreground="#93A0AF" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding MeasurementLabel}" FontSize="10"
                                                       Foreground="#6E7681"/>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}"
                                                   Margin="0,4,0,0"/>

                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="MEDIR BASE" Tag="baseline"
                                                    Click="CatalogAction_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SupportsBaseline}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="APLICAR" Tag="apply"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="CatalogAction_Click"
                                                    IsEnabled="{Binding CanApply}"/>
                                            <Button Content="REVERTIR" Tag="rollback"
                                                    Style="{StaticResource DangerButton}"
                                                    Click="CatalogAction_Click"
                                                    IsEnabled="{Binding CanRollback}"/>
                                            <Button Content="MEDIR POSTERIOR" Tag="measure"
                                                    Click="CatalogAction_Click"
                                                    IsEnabled="{Binding CanMeasure}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ═══════════════ DIAGNÓSTICO ═══════════════ -->
        <TabItem Header="DIAGNÓSTICO DE HARDWARE">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="4,4,4,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="VOLVER A MEDIR" Style="{StaticResource PrimaryButton}"
                                Click="RefreshDiagnostics_Click"
                                IsEnabled="{Binding CanRefreshDiagnostics}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="DIAGNÓSTICO DE HARDWARE (SOLO LECTURA)" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DiagnosticStatusText, Mode=OneWay}"
                                   Style="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding DiagnosticSummaryText, Mode=OneWay}" FontSize="11"/>
                        <TextBlock Text="{Binding LastDiagnosticAtText, Mode=OneWay}"
                                    Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="2" Margin="4" ItemsSource="{Binding HardwareFactRows}"
                          AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="DATO" Binding="{Binding Name}" Width="190"/>
                        <DataGridTextColumn Header="VALOR" Binding="{Binding Value}" Width="*"/>
                        <DataGridTextColumn Header="ORIGEN" Binding="{Binding Source}" Width="220"/>
                        <DataGridTextColumn Header="CONFIANZA" Binding="{Binding Confidence}" Width="85"/>
                        <DataGridTextColumn Header="MEDIDO" Binding="{Binding MeasuredAtText}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="4">
                    <ItemsControl ItemsSource="{Binding DiagnosticFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#11161D" BorderBrush="#26303B"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10" Margin="0,3">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Severity}" DockPanel.Dock="Right"
                                                       FontSize="10" FontWeight="Bold" Foreground="#F0883E"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Explanation}" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Evidence}" FontSize="10"
                                                   Foreground="#93A0AF" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Recommendation}" FontSize="10"
                                                   Foreground="#4A9EFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ═══════════════ CS2 CONFIG ═══════════════ -->
        <TabItem Header="CS2 CONFIG">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="CS2 · GESTOR DE CONFIGURACIÓN"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Margin="4,0,4,10"
                               Text="Administra variables seleccionadas en autoexec.cfg. EVO conserva el resto del archivo y no aplica cambios al sistema, a Steam ni al anticheat."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ARCHIVO DE CONFIGURACIÓN" Style="{StaticResource MetricLabel}"/>
                            <DockPanel Margin="0,6,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="BUSCAR AUTOEXEC" Click="BrowseCs2Config_Click"/>
                                    <Button Content="LEER" Style="{StaticResource PrimaryButton}"
                                            Click="LoadCs2Config_Click"/>
                                </StackPanel>
                                <TextBox Text="{Binding Cs2ConfigPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Ruta a game\csgo\cfg\autoexec.cfg"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Cs2ConfigStatusText, Mode=OneWay}"
                                       Foreground="#4A9EFF" Margin="2,8,2,0"/>
                            <TextBlock Text="{Binding Cs2ConfigBackupText, Mode=OneWay}"
                                       Style="{StaticResource Muted}" Margin="2,4,2,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="BORRADOR DE PERFIL EVO" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                                       Text="Variables permitidas: cl_hud_color, cl_showfps, fps_max, fps_max_ui, r_fullscreen_gamma. Se valida sintaxis numérica, no que la versión actual del juego acepte cada variable; no hay valores preseleccionados ni promesas de FPS."/>
                            <DockPanel>
                                <Button Content="AGREGAR VARIABLE" DockPanel.Dock="Right"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="AddCs2ConfigSetting_Click"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewCs2ConfigName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,6,0"
                                             ToolTip="Nombre de una variable permitida"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewCs2ConfigValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Valor numérico elegido por vos"/>
                                </Grid>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Cs2ConfigSettings}"
                                      SelectedItem="{Binding SelectedCs2ConfigSetting, Mode=TwoWay}"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      Height="230"
                                      Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="VARIABLE"
                                                        Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="2*"/>
                                    <DataGridTextColumn Header="VALOR"
                                                        Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="QUITAR SELECCIONADA"
                                        Click="RemoveCs2ConfigSetting_Click"/>
                                <Button Content="ESCRIBIR PERFIL CON CONFIRMACIÓN"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="{Binding CanApplyCs2Config}"
                                        Click="ApplyCs2Config_Click"/>
                                <Button Content="RESTAURAR BACKUP"
                                        Background="#7E363C"
                                        IsEnabled="{Binding CanRestoreCs2Config}"
                                        Click="RestoreCs2Config_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SEGURIDAD Y LÍMITES" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Margin="0,4,0,0"
                                       Text="Cada escritura requiere confirmación, crea un backup verificable y se bloquea mientras CS2 está abierto. Restaurar solo está disponible si el archivo coincide con el último estado escrito por EVO; si detecta cambios externos, no sobrescribe. La operación modifica únicamente autoexec.cfg."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══════════════ EVO AI ═══════════════ -->
        <TabItem Header="EVO AI">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="EVO AI · COORDINACIÓN DE MOTORES" FontSize="19" FontWeight="Bold" Margin="4"/>
                    <TextBlock Text="{Binding EvoAiSummaryText, Mode=OneWay}"
                               FontSize="12" Foreground="#4A9EFF" Margin="4,4,4,10"/>

                    <TextBlock Text="DECISIONES EXPLICADAS" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding EvoAiDecisions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Confidence}" DockPanel.Dock="Right"
                                                       FontSize="10" Foreground="#3FB950" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Explanation}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Evidence}" FontSize="10"
                                                   Foreground="#93A0AF" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding SuggestedAction}" FontSize="10"
                                                   Foreground="#4A9EFF" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="CONFLICTOS" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding EvoAiConflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#F0883E" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="ADVERTENCIAS DE EVIDENCIA" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding EvoAiWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#D29922" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</UserControl>