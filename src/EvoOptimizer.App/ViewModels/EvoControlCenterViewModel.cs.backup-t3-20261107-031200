    }

    public double CommitLimitMb
    {
        get => _commitLimitMb;
        private set => SetField(ref _commitLimitMb, value);
    }

    public double Cs2MemoryMb
    {
        get => _cs2MemoryMb;
        private set => SetField(ref _cs2MemoryMb, value);
    }

