/// <summary>
/// ViewModel del Centro de Control. Orquesta el monitor en vivo, la topología híbrida Intel,
/// el estado de Windows Gaming, el analizador de cuellos de botella y el motor adaptativo.
/// Todos los setters son privados: los bindings XAML deben usar Mode=OneWay.
/// </summary>
public sealed class EvoControlCenterViewModel :
    INotifyPropertyChanged, IAsyncDisposable
{
