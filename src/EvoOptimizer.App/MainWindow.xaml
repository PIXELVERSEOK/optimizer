<Window x:Class="EvoOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EvoOptimizer.App.Views"
        Title="EVO FPS OPTIMIZER | Performance Engineering System"
        Width="1560"
        Height="940"
        MinWidth="1120"
        MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border BorderBrush="#29323E" BorderThickness="1" CornerRadius="12"
            Background="{StaticResource BgBrush}">
        <views:EvoDashboardShell x:Name="DashboardShell"/>
    </Border>
</Window>
